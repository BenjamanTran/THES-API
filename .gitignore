# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore environment files except example.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/
!/log/.keep
!/tmp/.keep

# rack-mini-profiler (many files under tmp/miniprofiler/)
/tmp/miniprofiler/

# Ignore pidfiles, but keep the directory.
/tmp/pids/
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# GCS service account keys
/config/gcs/*.json
!/config/gcs/service-account.json.example

# Local avatar uploads (when GCS_MEDIA_BUCKET unset)
/public/avatars/*
!/public/avatars/.gitkeep
