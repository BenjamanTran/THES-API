RAILS_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PASSWORD=
DB_USERNAME=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# A/B test: game detail UI (Split gem). Config: config/experiments.yml (legacy vs simple %)
# Dashboard (local): http://localhost:3000/split
SPLIT_ENABLED=true
# Sinatra host allowlist for /split (comma-separated; production default includes api.smashhub88.win)
# SPLIT_PERMITTED_HOSTS=api.smashhub88.win,localhost,127.0.0.1
# Force variant for everyone: legacy | simple (overrides Split + YAML weights)
# GAME_DETAIL_SCREEN_VARIANT=simple

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Frontend origin (password reset / email verification links)
FE_ORIGIN=http://localhost:3001

# Shared auth cookie across FE + API subdomains (production)
# COOKIE_DOMAIN=.smashhub88.win

# Sidekiq Web UI (/sidekiq)
SIDEKIQ_USERNAME=
SIDEKIQ_PASSWORD=

# Transactional email (Resend)
RESEND_API_KEY=
MAIL_FROM=SmashHub <noreply@smashhub88.win>
